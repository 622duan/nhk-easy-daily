      "title_jp": "減税に伴う地方減収 国穴埋め検討",
      "title_zh": "",
      "duration": "4:00",
      "plays": "new",
      "thumb": "https://news-pctr.c.yimg.jp/t/news-topics/images/tpc/2026/8/11/aa57c8e32118b1c92fe8cfa586e27e66c508d9e94b964bfb265e9d0e505b833b.jpg",
